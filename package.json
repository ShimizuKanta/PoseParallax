{
  "name": "pose-parallax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-worker.mjs && tsc --noEmit && vite build",
    "assets": "node scripts/prepare-assets.mjs",
    "test:e2e": "playwright test",
    "start": ".venv/bin/python -m server",
    "start:http": ".venv/bin/python -m server --http"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "qrcode": "^1.5.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "esbuild": "^0.25.0"
  }
}
